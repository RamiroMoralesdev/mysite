---
import Buttons from "./buttons.astro"
---

<header class="w-full h-screen flex flex-col justify-center items-center">
    <div class="bg-[#0a0a23] w-full md:w-3/6 h-3/6 shadow-lg shadow-[#087ec4]">
        <Buttons></Buttons>

        <div class="h-full text-white text-2xl flex flex-col justify-center items-center">
            <img src="/1723754775499.jpeg" alt="Ramiro Morales" title="RamiroMoralesdev" class="w-32 rounded-full">
            <h1>Ramiro Morales</h1>
            <h3>Web Developer and Designer</h3>
        </div>

    </div>

</header>

<section class="w-full h-screen flex justify-center items-center">
    <div class="bg-[#0a0a23] w-3/6 h-3/6 shadow-lg shadow-[#087ec4] text-white">
        <Buttons></Buttons>

        <div class="w-full h-full flex flex-col justify-center items-center text-balance">
            <h1 class="text-2xl">SOBRE MI &hearts;</h1>
            <p class="w-fit md:w-4/5 h-full text-center my-10">
                Cuento con una sólida formación en Desarrollo web y Diseño Grafico, lo que me permite crear interfaces web modernas, funcionales y optimizadas para diferentes dispositivos lo que me capacita para desarrollar y gestionar sitios web dinámicos y adaptables a las necesidades del cliente.
            </p>

        </div>

    </div>
</section>
